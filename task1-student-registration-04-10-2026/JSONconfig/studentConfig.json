{
  "studentName": {
    "label": "Student Name",
    "type": "text",
    "required": true,
    "validation": {
      "minLength": 2,
      "maxLength": 50
    },
    "messages": {
      "required": "Student name is required",
      "minLength": "Student name must be at least 2 characters",
      "maxLength": "Student name must not exceed 50 characters"
    }
  },

  "enrollmentNo": {
    "label": "Enrollment No",
    "type": "text",
    "required": true,
    "unique": true,
    "messages": {
      "required": "Enrollment number is required",
      "unique": "Enrollment number already exists"
    }
  },

  "email": {
    "label": "Email",
    "type": "email",
    "required": true,
    "unique": true,
    "validation": {
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    },
    "messages": {
      "required": "Email is required",
      "pattern": "Please enter a valid email address",
      "unique": "Email already exists"
    }
  },

  "mobile": {
    "label": "Mobile",
    "type": "text",
    "required": true,
    "validation": {
      "pattern": "^[0-9]{10}$"
    },
    "messages": {
      "required": "Mobile number is required",
      "pattern": "Mobile number must contain exactly 10 digits"
    }
  },

  "dateOfBirth": {
    "label": "Date of Birth",
    "type": "date",
    "required": true,
    "messages": {
      "required": "Date of birth is required"
    }
  },

  "age": {
    "label": "Age",
    "type": "number",
    "required": true,
    "validation": {
      "min": 18,
      "max": 60
    },
    "messages": {
      "required": "Age is required",
      "min": "Age must be at least 18",
      "max": "Age must not exceed 60"
    }
  },

  "gender": {
    "label": "Gender",
    "type": "radio",
    "required": true,
    "options": [
      "Male",
      "Female",
      "Other"
    ],
    "messages": {
      "required": "Please select a gender"
    }
  },

  "course": {
    "label": "Course",
    "type": "select",
    "required": true,
    "options": [
      "M.Sc.IT",
      "B.Sc.IT",
      "MCA",
      "BCA"
    ],
    "messages": {
      "required": "Please select a course"
    }
  },

  "specialization": {
    "label": "Specialization",
    "type": "text",
    "required": true,
    "messages": {
      "required": "Specialization is required"
    }
  },

  "semester": {
    "label": "Semester",
    "type": "select",
    "required": true,
    "options": [
      1,
      2,
      3,
      4,
      5,
      6
    ],
    "messages": {
      "required": "Please select a semester"
    }
  },

  "address": {
    "label": "Address",
    "type": "textarea",
    "required": true,
    "messages": {
      "required": "Address is required"
    }
  },

  "city": {
    "label": "City",
    "type": "text",
    "required": true,
    "messages": {
      "required": "City is required"
    }
  },

  "state": {
    "label": "State",
    "type": "text",
    "required": true,
    "messages": {
      "required": "State is required"
    }
  },

  "skills": {
    "label": "Skills",
    "type": "checkbox",
    "required": true,
    "minSelection": 1,
    "options": [
      "Java",
      "C#",
      "PHP",
      "JavaScript",
      "Python"
    ],
    "messages": {
      "required": "Please select at least one skill"
    }
  },

  "hobbies": {
    "label": "Hobbies",
    "type": "checkbox",
    "required": true,
    "minSelection": 1,
    "options": [
      "Reading",
      "Gaming",
      "Cricket",
      "Music",
      "Travel"
    ],
    "messages": {
      "required": "Please select at least one hobby"
    }
  },

  "passportPhoto": {
    "label": "Passport Photo",
    "type": "file",
    "required": true,
    "validation": {
      "allowedTypes": [
        "image/jpeg",
        "image/png"
      ],
      "maxSize": 2097152
    },
    "messages": {
      "required": "Passport photo is required",
      "allowedTypes": "Only JPG and PNG images are allowed",
      "maxSize": "Passport photo must not exceed 2 MB"
    }
  }
}